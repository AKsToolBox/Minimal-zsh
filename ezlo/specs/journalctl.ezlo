# Auto-generated by `ezlo import` — review and move to ~/.config/ezlo/specs/ to customize.

cmd journalctl "journalctl [OPTIONS...] [MATCHES...]"
  opt --system "Show the system journal"
  opt --user "Show the user journal for the current user"
  opt -M --machine <container> "Operate on local container"
  opt -m --merge "Show entries from all available journals"
  opt -D --directory <path> path "Show journal files from directory"
  opt -i --file <path> path "Show journal file"
  opt --root <path> path "Operate on an alternate filesystem root"
  opt --image <path> path "Operate on disk image as filesystem root"
  opt --image-policy <policy> "Specify disk image dissection policy"
  opt --namespace <namespace> "Show journal data from specified journal namespace"
  opt -S --since <date> "Show entries not older than the specified date"
  opt -U --until <date> "Show entries not newer than the specified date"
  opt -c --cursor <cursor> "Show entries starting at the specified cursor"
  opt --after-cursor <cursor> "Show entries after the specified cursor"
  opt --cursor-file <file> file "Show entries after cursor in FILE and update FILE"
  opt -b --boot <id> "Show current boot or the specified boot"
  opt -u --unit <unit> "Show logs from the specified unit"
  opt --user-unit <unit> "Show logs from the specified user unit"
  opt --invocation <id> "Show logs from the matching invocation ID"
  opt -I "Show logs from the latest invocation of unit"
  opt -t --identifier <string> "Show entries with the specified syslog identifier"
  opt -T --exclude-identifier <string> "Hide entries with the specified syslog identifier"
  opt -p --priority <range> "Show entries within the specified priority range"
  opt -g --grep <pattern> "Show entries with MESSAGE matching PATTERN"
  opt -k --dmesg "Show kernel message log from the current boot"
  opt -o --output <string> "Change journal output mode (short, short-precise,"
  opt --output-fields <list> "Select fields to print in verbose/export/json modes"
  opt -r --reverse "Show the newest entries first"
  opt --show-cursor "Print the cursor after all the entries"
  opt --utc "Express time in Coordinated Universal Time (UTC)"
  opt -x --catalog "Add message explanations where available"
  opt --no-hostname "Suppress output of hostname field"
  opt --no-full "Ellipsize fields"
  opt -a --all "Show all fields, including long and unprintable"
  opt -f --follow "Follow the journal"
  opt --no-tail "Show all lines, even in follow mode"
  opt --truncate-newline "Truncate entries by first newline character"
  opt -q --quiet "Do not show info messages and privilege warning"
  opt --no-pager "Do not pipe output into a pager"
  opt -e --pager-end "Immediately jump to the end in the pager"
  opt --interval <time> "Time interval for changing the FSS sealing key"
  opt --verify-key <key> "Specify FSS verification key"
  opt --force "Override of the FSS key pair with --setup-keys"
  opt -h --help "Show this help text"
  opt --version "Show package version"
  opt -N --fields "List all field names currently used"
  opt -F --field <field> "List all values that a specified field takes"
  opt --list-boots "Show terse information about recorded boots"
  opt --list-invocations "Show invocation IDs of specified unit"
  opt --list-namespaces "Show list of journal namespaces"
  opt --disk-usage "Show total disk usage of all journal files"
  opt --vacuum-size <bytes> "Reduce disk usage below specified size"
  opt --vacuum-files <int> "Leave only the specified number of journal files"
  opt --vacuum-time <time> "Remove journal files older than specified time"
  opt --verify "Verify journal file consistency"
  opt --sync "Synchronize unwritten journal messages to disk"
  opt --relinquish-var "Stop logging to disk, log to temporary file system"
  opt --smart-relinquish-var "Similar, but NOP if log directory is on root mount"
  opt --flush "Flush all journal data from /run into /var"
  opt --rotate "Request immediate rotation of the journal files"
  opt --header "Show journal header information"
  opt --list-catalog "Show all message IDs in the catalog"
  opt --dump-catalog "Show entries in the message catalog"
  opt --update-catalog "Update the message catalog database"
  opt --setup-keys "Generate a new FSS key pair"
